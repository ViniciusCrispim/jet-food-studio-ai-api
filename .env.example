# Application Settings
APP_NAME="Jet Food Studio IA"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Security & Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_ORIGINS=["*"]

# AI Engine & Performance Settings
# Modelos suportados pelo rembg: "u2net" (maior precisão), "u2netp" (mais leve/rápido), "isnet-general-use"
AI_MODEL_NAME="u2netp"
PRELOAD_AI_MODEL=true
MAX_WORKER_THREADS=4

# Default Output Standards (Plataformas de Delivery)
DEFAULT_OUTPUT_FORMAT="WEBP"
DEFAULT_OUTPUT_QUALITY=92
